rules_version = '2';

// Every read and write in this app goes through an API route using the Firebase
// Admin SDK, which bypasses these rules entirely. No client code touches
// Firestore directly: lib/client.ts constructs `db` but nothing imports it, and
// there are no getDocs/onSnapshot/addDoc calls anywhere in app/ or components/.
//
// So the correct posture is to deny all direct client access. Authorisation
// lives in the API routes (see requireAdmin in lib/server-auth.ts), which verify
// an ID token and look the caller up in the `admins` collection.
//
// This replaces an earlier rule set that granted `read, update, delete` on
// /guests to ANY authenticated user, which let anyone who could sign up read or
// destroy the whole collection straight from the client SDK. Its
// `allow create: if true` is also gone: public registration is written
// server-side by /api/register, so the client never needs write access.
//
// Fails closed. If client-side Firestore access is ever added it will be denied
// until a specific rule is written for it; prefer adding an API route instead.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
